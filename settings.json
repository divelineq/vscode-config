{
  // --- Ограничения файловых наблюдателей и поиска
  "files.watcherExclude": {
    //? Не следим за этими папками (сильный прирост на JS/TS проектах)
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/.parcel-cache/**": true,
    "**/.pnpm/**": true,
    "**/coverage/**": true,
  },
  "files.exclude": {
    //? Прячем эти папки в Explorer (чтобы не мешали)
    "**/.git": true,
    "**/node_modules": false,
    "**/dist": false,
    "**/build": false,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/.parcel-cache": true,
    "**/.pnpm": true,
    "**/coverage": true,
  },
  "search.exclude": {
    //? Не ищем в этих папках (ускоряет поиск)
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/.parcel-cache": true,
    "**/.pnpm": true,
    "**/coverage": true,
  },
  "eslint.enable": true, //!
  "breadcrumbs.enabled": true, //? Убираем хлебные крошки сверху редактора
  "editor.minimap.enabled": false, //? Выключаем миникарту справа
  "editor.semanticHighlighting.enabled": true, //? Используем дорогую семантическую подсветку
  "editor.bracketPairColorization.enabled": false, //? Не раскрашиваем скобки (экономия CPU)
  "editor.guides.bracketPairs": false, //? Убираем линии соединяющие пары скобок
  "editor.guides.indentation": false, //? Убираем вертикальные линии отступов
  "editor.stickyScroll.enabled": false, //? Отключаем "прилипание" заголовков при скролле
  "editor.codeLens": false, //? Не показываем дополнительные ссылки над кодом
  "editor.inlayHints.enabled": "off", //? Отключаем маленькие типовые подсказки в коде
  "editor.inlineSuggest.enabled": false, //? Отключаем inline-подсказки (ghost text)
  "editor.occurrencesHighlight": "multiFile", //? Не подсвечиваем все вхождения переменной
  "editor.parameterHints.enabled": false, //? Убираем всплывающие подсказки параметров функций
  "editor.hover.delay": 500, //? Делаем задержку ховеров (меньше всплывашек = быстрее)
  "editor.smoothScrolling": false, //? Выключаем плавный скроллинг (ускоряет рендер)
  "editor.cursorSmoothCaretAnimation": "off", //? Убираем анимацию курсора
  "workbench.list.smoothScrolling": false, //? Выключаем плавный скролл в списках (Explorer и т.д.)
  "editor.glyphMargin": false, //? Не показываем слева пиктограммы (breakpoints, ошибки)
  "problems.decorations.enabled": true, //? Убираем подсветку ошибок на линейке справа
  "workbench.editor.enablePreview": true, //? Открываем файлы во временной вкладке, чтобы не копились сотни
  // --- Git/SCM
  "git.autofetch": false, //? Не подтягиваем изменения из git в фоне
  "git.decorations.enabled": true, //? Не показываем маркеры изменений в Explorer
  "git.untrackedChanges": "mixed", //? Прячем новые файлы в Explorer
  "scm.diffDecorations": "all", //? Не подсвечиваем строки с изменениями в редакторе
  // --- Терминал
  "terminal.integrated.gpuAcceleration": "off", //? Терминал без GPU — меньше нагрузка
  "terminal.integrated.smoothScrolling": false, //? Терминал без плавного скролла — быстрее
  "terminal.integrated.fontFamily": "JetBrains Mono",
  // --- TypeScript/JS
  "typescript.disableAutomaticTypeAcquisition": true, //? Не тянем тайпинги из сети автоматически (экономия)
  "javascript.suggest.autoImports": true, //? Не ищем автоимпорты в node_modules (сильно нагружает)
  "typescript.suggest.autoImports": true, //? То же самое для TS
  "javascript.suggest.completeFunctionCalls": false, //? Не вставляем скобки при автодополнении функций
  "typescript.suggest.completeFunctionCalls": false, //? То же самое для TS
  "typescript.updateImportsOnFileMove.enabled": "always", //? Не обновляем импорты при переносе файлов (экономия)
  "typescript.preferences.includePackageJsonAutoImports": "on", //? Ищем пакеты из package.json для автодополнения
  "typescript.tsserver.watchOptions": {
    //? Настраиваем watchers для уменьшения нагрузки
    "watchFile": "useFsEventsOnParentDirectory", //? Используем события ОС вместо постоянного опроса
    "watchDirectory": "useFsEvents", //? То же самое для папок
    "fallbackPolling": "dynamicPriorityPolling", //? Если нет событий ОС — минимальный поллинг
  },
  // --- ESLint
  "eslint.run": "onType", //? Проверяем код прямо при вводе
  "eslint.validate": [
    //? Валидируем все JS/TS файлы
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto",
    },
  ], //? Автоопределяем корень проекта для ESLint (важно в монорепах)
  // --- Форматирование
  "editor.formatOnSave": true, //? Fорматируем при сохранении
  "editor.formatOnPaste": false, //? Не форматируем при вставке
  "editor.formatOnType": false, //? Не форматируем при наборе текста
  // --- Телеметрия и история
  "telemetry.telemetryLevel": "off", //? Выключаем сбор статистики (меньше фоновых задач)
  "workbench.tree.enableStickyScroll": false,
  "editor.tabCompletion": "on",
  "emmet.triggerExpansionOnTab": true,
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.linkedEditing": true,
  },
  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.linkedEditing": true,
    "editor.defaultFormatter": "biomejs.biome",
  },
  "cSpell.language": "en,ru",
  "css.lint.unknownAtRules": "ignore",
  "debug.openDebug": "openOnDebugBreak",
  "editor.accessibilitySupport": "off",
  "editor.autoClosingBrackets": "always",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
  },
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "editor.renderWhitespace": "none",
  "workbench.startupEditor": "none",
  "breadcrumbs.symbolPath": "off",
  "window.openFilesInNewWindow": "off",
  "window.zoomLevel": -2,
  "window.density.editorTabHeight": "compact",
  "typescript.tsserver.maxTsServerMemory": 2048,
  "workbench.layoutControl.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.verticalScrollbarSize": 12,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line-thin",
  "editor.folding": true,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontLigatures": false,
  "editor.fontSize": 14.5,
  "editor.linkedEditing": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.wordWrap": "on",
  "emmet.includeLanguages": {
    "blade": "html",
    "ejs": "html",
    "javascript": "javascriptreact",
    "mustache": "html",
  },
  "emmet.syntaxProfiles": {
    "blade": "html",
    "mustache": "html",
  },
  "editor.quickSuggestionsDelay": 100,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.enableDragAndDrop": true,
  "explorer.incrementalNaming": "smart",
  "extensions.ignoreRecommendations": false,
  "files.autoSave": "off",
  "files.eol": "\n",
  "git.confirmSync": false,
  "html.format.enable": true,
  "html.format.indentHandlebars": true,
  "html.format.maxPreserveNewLines": 0,
  "html.format.wrapAttributes": "aligned-multiple",
  "html.format.wrapLineLength": 100,
  "javascript.preferences.useAliasesForRenames": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left",
  },
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "zsh",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "icon": "terminal-bash",
      "path": "bash",
    },
    "fish": {
      "path": "fish",
    },
    "sh (2)": {
      "path": "/usr/bin/sh",
    },
    "zsh": {
      "path": "/usr/bin/zsh",
      "args": ["-l", "-i"],
    },
  },
  "typescript.preferences.useAliasesForRenames": false,
  "workbench.editor.empty.hint": "hidden",
  "terminal.integrated.env.windows": {},
  "git.replaceTagsWhenPull": true,
  "explorer.confirmPasteNative": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "workbench.tips.enabled": false,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Adonis+ Eclipse",
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": ["-l"],
    },
  },
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.suggest.enabled": true,
  "workbench.colorCustomizations": {},
  "workbench.experimental.modernUI": true,
  "window.titleBarStyle": "custom",
  "application.shellEnvironmentResolutionTimeout": 30,
  "cSpell.userWords": [
    "пинга",
    "bybit",
    "Coinexis",
    "horz",
    "ipfs",
    "klines",
    "nums",
    "nuqs",
    "Ohlc",
    "Pcnt",
    "sonner",
    "Sparkline",
    "wagmi",
  ],
  "gitlens.home.preview.enabled": false,
  "window.commandCenter": false,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.iconTheme": "material-icon-theme",
  "terminal.integrated.initialHint": false,
}
