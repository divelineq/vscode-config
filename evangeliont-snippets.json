  "useState": {
    "prefix": "us",
    "body": ["const [$1, set${1/(.)/${1:/capitalize}/}] = useState($0);"],
  },
  "useMemo": {
    "prefix": "um",
    "body": ["const $1 = useMemo(() => $2, [$0]);"],
  },
  "useEffect": {
    "prefix": "ue",
    "body": ["useEffect(() => {", "$1", "}, [$0]);"],
  },
  "useCallback": {
    "prefix": "uc",
    "body": ["const $1 = useCallback(() => $2, [$0]);"],
  },
