    "body": [
      "import { observer } from 'mobx-react-lite';",
      "",
      "interface Props {}",
      "",
      "const ${1:$TM_FILENAME_BASE} = observer<Props>(function ${1:$TM_FILENAME_BASE}() {",
      "  return ${0:null};",
      "});",
      "",
      "export { ${1:$TM_FILENAME_BASE} };",
    ],
    "description": "Компонент, обёрнутый в mobx observer",
    "isFileTemplate": true,
  },
  "Компонент в mobx observer с generic параметром": {
    "prefix": "rfcog",
    "body": [
