{
  "Компонент react": {
    "prefix": "rfc",
    "body": [
      "interface Props {}",
      "",
      "function ${1:$TM_FILENAME_BASE} ({}: Props) {",
      "  return ${0:null};",
      "}",
      "",
      "export { ${1:$TM_FILENAME_BASE} };",
    ],
    "description": "Компонент react без доп. обёрток",
    "isFileTemplate": true,
  },
  "Компонент, обёрнутый в mobx observer": {
