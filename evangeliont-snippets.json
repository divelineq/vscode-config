      "",
      "const ${1:$TM_FILENAME_BASE} = memo<Props>(function ${1:$TM_FILENAME_BASE}(props) {",
      "  return ${0:null};",
      "});",
      "",
      "export { ${1:$TM_FILENAME_BASE} };",
