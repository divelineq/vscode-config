      "",
      "const ${1:$TM_FILENAME_BASE} = observer(function ${1:$TM_FILENAME_BASE}<${1:T} $2>({}: Props<${1:T}>) {",
      "  return ${0:null};",
      "});",
      "",
      "export { ${1:$TM_FILENAME_BASE} };",
    ],
    "description": "Компонент, обёрнутый в mobx observer с generic параметром",
    "isFileTemplate": true,
  },
